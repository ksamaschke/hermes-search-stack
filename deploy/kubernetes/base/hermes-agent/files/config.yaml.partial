providers:
  # The pinned Hermes runtime resolves `key_env` for a custom endpoint through
  # a named provider. Bare `custom` plus model.base_url skips that lookup and
  # can fall back to the literal credential "no-key-required".
  hermes-search-stack:
    base_url: ${HERMES_MODEL_BASE_URL}
    key_env: HERMES_GATEWAY_API_KEY
    default_model: ${HERMES_MODEL_DEFAULT}

model:
  # Keep the selector environment-driven for deliberate provider overrides.
  # Stack defaults select the named OpenAI-compatible provider above.
  provider: ${HERMES_MODEL_PROVIDER}
  default: ${HERMES_MODEL_DEFAULT}

plugins:
  # Deny-list only.
  #
  # Do NOT add `plugins.enabled` here: bundled plugins (everything shipped in
  # the image, including web/searxng and web/firecrawl) load regardless of the
  # allow-list - it only gates standalone/user-installed/entry-point plugins.
  # Setting it therefore does not shorten discovery, and getting the key format
  # wrong is silent: keys are path-derived ("web/searxng", not "web-searxng"),
  # so a plausible-looking list is simply ignored.
  disabled:
    # Both raise "dictionary changed size during iteration" during discovery.
    # The loader catches it and logs a warning, so this is noise reduction
    # rather than a fix, but it keeps the startup log readable.
    - openrouter
    - browser-browserbase
    # Everything below is dead weight for a search stack and is where startup
    # actually goes. Measured from the in-cluster log, a single boot spent
    # 269s registering browser-browser-use, 128s and 119s on deepinfra, plus
    # 105s and 66s in check_browser_* capability probes - all for providers
    # this stack has no credentials for and never calls. The registry probes
    # each one anyway ("check_fn ... returned False; dependent tools will be
    # unavailable"), and every probe is CPU-bound: the gateway holds ~1.5-2.4
    # cores on a single thread while doing it.
    #
    # We need exactly two web providers (searxng, firecrawl) and a chat model.
    # Browser automation and image/video generation are not part of this stack.
    #
    # Names verified against the plugin.yaml manifests in the image; the loader
    # matches on either the path-derived key or the bare manifest name
    # (plugins.py: `if lookup_key in disabled or manifest.name in disabled`).
    - browser-browser-use
    - browser-firecrawl   # the browser variant; web-firecrawl is the one we use
    - deepinfra           # image_gen/deepinfra
    - fal
    - krea
    - openai-codex
    - xai                 # image_gen/xai

security:
  # Turn OFF runtime pip installs.
  #
  # The image sets HERMES_DISABLE_LAZY_INSTALLS=1, but that only seals the
  # agent venv: it also sets HERMES_LAZY_INSTALL_TARGET=/opt/data/lazy-packages,
  # and /opt/data is our writable PVC, so _allow_lazy_installs() flips back to
  # True. The gateway then pip-installs optional extras on every boot - slow
  # enough to eat the entire startup window - the process sits at 100% CPU
  # holding zero sockets and never reaches the API server bind, so 8642 stays
  # closed while s6 reports the service healthy.
  #
  # allow_lazy_installs: false is the documented opt-out that disables installs
  # in BOTH modes. Optional extras belong in a derived image, not on the PVC.
  # Also enforced via HERMES_LAZY_INSTALL_TARGET="" in the deployment, because
  # config.yaml lives on the PVC and can be shadowed by stale state.
  allow_lazy_installs: false
  # The agent uses a private network path to SearXNG/Firecrawl, both of which
  # are cluster-internal hostnames.
  allow_private_urls: true

gateway:
  # OpenAI-compatible endpoint that Open WebUI and the Hermes WebUI consume.
  #
  # The shape here is not cosmetic. gateway/config.py enrolls this platform via
  # _PLATFORM_CONNECTED_CHECKERS[Platform.API_SERVER], which reads
  # `cfg.extra["key"]` - so the key must live under platforms.api_server.extra.
  # Container-wide API_SERVER_* env vars alone left the gateway process up with
  # port 8642 never bound and no platform ever logged.
  #
  # `key` is a placeholder; bootstrap.py substitutes the real value from the
  # API_SERVER_KEY env var (injected from hermes-agent-secrets) at render time,
  # so the secret never lives in git.
  platforms:
    api_server:
      enabled: true
      extra:
        key: ${API_SERVER_KEY}
        # 0.0.0.0 is required so the Service can reach it; the default
        # 127.0.0.1 is only reachable inside the pod's own netns.
        host: 0.0.0.0
        port: 8642

web:
  # Explicit per-capability routing. This MUST be set explicitly:
  # Hermes' env auto-detection ranks FIRECRAWL_API_URL ABOVE SEARXNG_URL,
  # so leaving it to auto-detect would silently route SEARCH to Firecrawl
  # too. SearXNG is search-only; Firecrawl is the extractor.
  search_backend: searxng
  extract_backend: ${HERMES_EXTRACT_BACKEND}
  keyless_fallback: false
  keyless_rescue: false

agent:
  max_turns: 90

terminal:
  backend: local
  cwd: /opt/data/workspace
