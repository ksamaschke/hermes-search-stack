model:
  # Provider/base_url/model are environment-specific: set them in an overlay.
  # `key_env` names the ENV VAR holding the key - never the key itself.
  provider: ${HERMES_MODEL_PROVIDER}
  default: ${HERMES_MODEL_DEFAULT}
  base_url: ${HERMES_MODEL_BASE_URL}
  key_env: HERMES_GATEWAY_API_KEY

security:
  # Turn OFF runtime pip installs.
  #
  # The image sets HERMES_DISABLE_LAZY_INSTALLS=1, but that only seals the
  # agent venv: it also sets HERMES_LAZY_INSTALL_TARGET=/opt/data/lazy-packages,
  # and /opt/data is our writable PVC, so _allow_lazy_installs() flips back to
  # True. The gateway then pip-installs optional extras on every boot - slow
  # enough to eat the entire startup window - the process sits at 100% CPU
  # holding zero sockets and never reaches the API server bind, so 8642 stays
  # closed while s6 reports the service healthy.
  #
  # allow_lazy_installs: false is the documented opt-out that disables installs
  # in BOTH modes. Optional extras belong in a derived image, not on the PVC.
  # Also enforced via HERMES_LAZY_INSTALL_TARGET="" in the deployment, because
  # config.yaml lives on the PVC and can be shadowed by stale state.
  allow_lazy_installs: false
  # The agent runs inside a sandboxed runtime with a private network path
  # to SearXNG/Firecrawl, both of which are cluster-internal hostnames.
  allow_private_urls: true

gateway:
  # OpenAI-compatible endpoint that Open WebUI and the Hermes WebUI consume.
  #
  # The shape here is not cosmetic. gateway/config.py enrolls this platform via
  # _PLATFORM_CONNECTED_CHECKERS[Platform.API_SERVER], which reads
  # `cfg.extra["key"]` - so the key must live under platforms.api_server.extra.
  # Container-wide API_SERVER_* env vars alone left the gateway process up with
  # port 8642 never bound and no platform ever logged.
  #
  # `key` is a placeholder; bootstrap.py substitutes the real value from the
  # API_SERVER_KEY env var (injected from hermes-agent-secrets) at render time,
  # so the secret never lives in git.
  platforms:
    api_server:
      enabled: true
      extra:
        key: ${API_SERVER_KEY}
        # 0.0.0.0 is required so the Service can reach it; the default
        # 127.0.0.1 is only reachable inside the pod's own netns.
        host: 0.0.0.0
        port: 8642

web:
  # Explicit per-capability routing. This MUST be set explicitly:
  # Hermes' env auto-detection ranks FIRECRAWL_API_URL ABOVE SEARXNG_URL,
  # so leaving it to auto-detect would silently route SEARCH to Firecrawl
  # too. SearXNG is search-only; Firecrawl is the extractor.
  search_backend: searxng
  extract_backend: ${HERMES_EXTRACT_BACKEND}
  keyless_fallback: false
  keyless_rescue: false

agent:
  max_turns: 90

terminal:
  backend: local
  cwd: /opt/data/workspace
