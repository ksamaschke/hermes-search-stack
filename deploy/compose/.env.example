# Hermes Search Stack — Compose configuration
#
# Copy to `.env`, then run ./init.sh to fill in the generated secrets.
#   cp .env.example .env && ./init.sh
#
# NEVER commit the resulting .env — it is git-ignored for a reason.

# ---------------------------------------------------------------------------
# REQUIRED: your model gateway
# ---------------------------------------------------------------------------
# Any OpenAI-compatible endpoint: a self-hosted gateway, LiteLLM, vLLM,
# OpenRouter, Ollama, etc.
# Keep the named stack provider for this route. With the pinned Hermes image,
# bare `custom` plus an explicit base URL does not resolve this key_env.
HERMES_MODEL_PROVIDER=hermes-search-stack
HERMES_MODEL_DEFAULT=REPLACE_ME
HERMES_MODEL_BASE_URL=https://REPLACE_ME/v1
HERMES_GATEWAY_API_KEY=

# ---------------------------------------------------------------------------
# Generated secrets — populated by ./init.sh, do not fill by hand
# ---------------------------------------------------------------------------
HERMES_API_SERVER_KEY=
HERMES_WEBUI_PASSWORD=
OPEN_WEBUI_SECRET_KEY=
SEARXNG_SECRET=
FIRECRAWL_POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Host UID/GID owning the hermes volume (Linux: `id -u` / `id -g`).
HERMES_UID=1000
HERMES_GID=1000

# Where Open WebUI binds on the host. 0.0.0.0 exposes it on the LAN —
# only do that behind a reverse proxy with TLS.
OPEN_WEBUI_BIND=127.0.0.1
OPEN_WEBUI_PUBLIC_URL=http://localhost:3000

# Scraper. Set WEB_LOADER_ENGINE= (empty) and HERMES_EXTRACT_BACKEND= (empty)
# to run search-only without Firecrawl.
HERMES_EXTRACT_BACKEND=firecrawl
WEB_LOADER_ENGINE=firecrawl
FIRECRAWL_API_URL=http://firecrawl-api:3002
